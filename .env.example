# AI provider (server-side only, never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
# Model used for generation and AI steps
ANTHROPIC_MODEL=claude-haiku-5-5
# Estimated pricing in USD per million tokens. Set these to your model's current pricing.
AI_INPUT_COST_PER_MTOK=1
AI_OUTPUT_COST_PER_MTOK=5

# Public demo limits (enforced on the server)
DEMO_GENERATIONS_PER_DAY=5
DEMO_AI_CALLS_PER_DAY=20
DEMO_GLOBAL_AI_CALLS_PER_DAY=300

# Origins allowed to embed this app in an iframe, comma-separated (for example https://yourname.dev)
EMBED_ALLOWED_ORIGINS=

# Supabase (used from Stage 3 onward)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
